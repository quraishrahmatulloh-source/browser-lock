{
  "manifest_version": 3,
  "name": "Browser Lock",
  "version": "1.0",
  "description": "Lock Chrome with a password or Touch ID. Every tab stays covered until you unlock. No account, no internet, data stays on your computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Browser Lock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "lock-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Lock the browser now"
    },
    "panic": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Panic button: lock, minimize windows, clear clipboard"
    },
    "lock-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Lock this tab only (other tabs stay open)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lock.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
