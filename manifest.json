{
  "manifest_version": 3,
  "name": "Browser Lock",
  "version": "1.0",
  "description": "Kunci Chrome dengan password. Semua tab tertutup sampai password benar. Tanpa akun, tanpa internet, data cuma di komputer lo.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "idle", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Browser Lock",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "lock-now": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Kunci browser sekarang"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
